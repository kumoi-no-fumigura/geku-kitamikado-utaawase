 "poems": [
  {
   "seq": "1",
   "text": "もろく散木の葉はかりや槇のやに過る時雨の音のこすらん",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "うき雲のはれても猶そ時雨ける木のはをさそふ峯のあらしに",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "とひすくる跡にももろき泪かなこのはの音はよそに時雨て",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "浮雲ははれ行跡の山風に猶時雨るゝや木のは成らむ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "吹よはるかたにやふかく積るらん嵐にもろきみねのもみち葉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "ちりしくも又さそはるゝ朝かせに霜のとたえを見る木の葉哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "吹きさそふ風のまゝなる木の葉にも已れと散や猶ましならん",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "時雨かと聞はかりにや吹風にさそふこのはも袖ぬらすらむ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "定めなく時雨るゝ頃とおもはすは何にこのはの音まかへまし",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "吹かせにもろき木の葉を時雨かときゝまかへてもぬるゝ袖哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "もろくちる程もしられて吹風の絕まにも猶散このはかな",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "音たてし木のはやうすくなりぬらん誘ふにつけてよはる風哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "しくれつる音はつれ行山風にまたをとつれてふる木のは哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "槇のやに時雨てもらぬ音つれや嵐にたくふ木のはなるらん",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "吹く風のさそはぬひまもをのつから心ともろくちる木の葉哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "聞たゆむひまこそなけれ木のは散やとは時雨の幾めくりとも",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "とひすつる時雨の跡の山風にまたをとつれて散木のはかな",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "さそひ行嵐の跡の山のはに殘るもみちの色そすくなき",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "しくれつる雲まに出て定めなきそらのならひは月もしりけり",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "山の端に時雨るゝ雲の吹すてゝ風の跡よりいつる月かな",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "さやけさは秋にかはらぬ月影のこほるそ冬のしるし也ける",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "影まても秋にかはりてこほるよの月のかつらに霜や置らむ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "さゆる夜のひかりを霜に置そへてひとつにこほる冬の月かけ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "しくれぬる雲をはよそに吹すてゝ嵐にこほる冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "更るよのあらしにこほる池水にやとらぬ月の影そさえゆく",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "とひなれし露の名殘をしたひてやかれ野の月の霜にさゆらん",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "冬そ見し秋のかたみを淺茅生のそてに殘して泳る月かけ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "しくれけるもりの木葉の跡とめてもりくる月の影の淋しさ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "霜むすふ尾花はくちて我袖の涙をつゆとやとる月哉",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "しも結ふおはなかそてをよすかにて露の跡とふ野への月かけ",
   "kana": "",
   "speaker": "",
   "page": 353,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "見るまゝにさえこそまされ山風のこほりて更る冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "木のまもるこヽろつくしの秋よりも猶さえまさる冬の夜の月",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "露ならて玉とそ見ゆるをく霜のこほれは移るあさちふの月",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "木からしの雲ふきさそふ山のはにさらて殘れる冬の夜の月",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "この葉のみ嵐のつてに時雨きてくもらぬ空に冴る月かな",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "淺茅生の露の跡とふ月のみや霜にもかれぬ秋の面かけ",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "はらはねは朝たつ袖も白妙の雪をかさぬる旅衣かな",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "水くきの岡のやかたは跡もなしねての朝けの雪のふかさに",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "わか跡を人もとめてや歸るらん今朝ふみ分る雪の下道",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "夜のまより雲のみふかくかさなりてまた一重なる今朝の初雪",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "霜かれしあとさへけさは絕にけり雪の下なる野へのみとりは",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "今朝のまをとふへき人は誰なれはたのめぬ跡を雪に待らん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "明わたる外山も雪のふかしとや出る日影の猶こほるらん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "うき宿の習ひになさぬ雪ならはとはるゝ跡もけさや待たれん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "今朝も猶人のとはすは庭の雪に我あとおしむかひやなからむ",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "とはれねは我出かての跡をのみけさはつけつる庭の雪哉",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "今朝はまた庭にやつまぬ雪なれととはれはいかゝ跡も厭はん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "けさも猶とふ人をそき庭のゆきにまたぬ日影の跡やいとはむ",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "終夜つもれる程もかつ見えて雪にそしらむ窓の朝明",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ゆきのうちに心かよはゝとふやとて我をも人のけさや待らむ",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "旅ころも朝たつ道の行末もまよふ計の野へのしら雪",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "いつくをか干かたともみん朝朗なみにつゝきて積る白雪",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "草のはら朝たつ野邊の行末を誰にとはまし雪の下道",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "いつのまに人のとはぬもうらむらん今朝こそつもれ庭の白雪",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "うき身をは人もゆるさぬ命もて逢にかへはと何賴むらん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "つれなさも憂身もたえてなからへは等閑なりと人や思はん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "何ともむくひとならはうき人のつれなさも又みにや歸らん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "つれなさのうつ〓に限る中ならは夢にや人のあふと見えまし",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "ことの葉の情もあらはをのつからうきにや殘る涙ならまし",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "數ならぬ身をかこてとや僞の情にたにもなをもらすらん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "こひしなん命より猶なき跡におしかるへきは憂名也けり",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "かひなしや後の世とたに逢事を契らぬ中にすてむ命は",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "つれなさをしたひ忘ぬとし月のつもれる程は人もしるらん",
   "kana": "",
   "speaker": "",
   "page": 354,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "逢事にかへはと思ふあらましの末もたのまぬわか命哉",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "こりす猶したふ心よつれなさのはてもや有と何たのむ覽",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "つれなさの程をしらすは同し世になからへはとも賴れやせむ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "等閑のつれなさならは數ならぬ身を忘てもしたはれやせん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "いたつらに憂名なかして妹せ川へたつる中はあふせたになし",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "まてといふ誰あらましになからへてうきに命の猶殘る覽",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "つれなさやおもひよはるとなからへて待みる程の命とも哉",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "つれなさもはてしあらはと賴身の心なかさや命成らん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "つれなさをいつまてとてかしたふらん命は人のかきり有世に",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "かはるやと人をうたかふ心にてとはて更るもいとゝかなしき",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "待よひも誰あらましに更ぬとてとはれは人の憂になすらん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "更てうき影ともなるはまつ事のまた身に殘る山のはの月",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "宵のまは待に賴みもあるものを更るもつらき月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "僞のつらさにこりぬ心かなちきれは人の猶またれつゝ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "うき人の僞しるく更る夜に猶まちすてぬ程もつれなし",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "せめてなと來ぬ夜あまたの僞をまたしとたにも思はさるらん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "とはれけるいつの夕へのならひとて契れは人の猶またるらむ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "僞もいつの限にたのめとて今よひも更る契なるらむ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "宵のまとおもはゞせめて僞の契もたのむかたやあらまし",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "たのめぬを我あらましに待よひの更るは人の僞もなし",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "いつはりとおもふ心も誰なれは猶まちすてぬ夕なるらん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "さりともとまつに賴みを殘す夜の更もつらき鐘の音かな",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "とはれすば後のつらさとなりやせむこよひは賴む人の言のは",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "まちあかす我あかつきの鐘の音をたか別れにかなして聞らん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "有明の月は雲ゐに出ぬれとまたれてとはぬ人そつれなき",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "とはるへき賴をなにゝ殘してか思ひもすてぬゆくゑ成らむ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "僞はなか〓〓うしと思へとも契れはたのむゆふくれのそら",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "慕ひてもかひなき身こそかこたるれ人の心のつらきのみかは",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "身の程をおもひしりてもうき人のつらさにたへぬ我なみた哉",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "しらせはやまくすか原の秋風にたへぬ恨のありと計に",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "つらからは思ひもたえて何とたゝしたふ恨の猶のこる覽",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "人をのみつらきになして恨るや身のとかしらぬ心なるらん",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "こゝろにはのこる恨のありとたにことに出ねは知人やなき",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "かきくらす淚にまけてつらさをも思ふ計はいひそしらせぬ",
   "kana": "",
   "speaker": "",
   "page": 355,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "うき身そと思ひしりぬる心をは誰になしてか又うらむらん",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "ことはりをおもひしらすは數ならぬみを忘てやなを恨まし",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "身をしれは人の心のつらさをも恨るまての言の葉そなき",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "心にやさても殘るらん言の葉にいひ盡すへきつらさならねは",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "さのみとていはぬ日數の移をもうらみよはると人や思はん",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "身の程をおもひもしらはせめてなと人のつらさを忘さるらん",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "數ならぬみの〓とはりのしられすは人のつらさを猶やまさらむ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "よしやたゝ風のたよりの眞葛原うらみしかひも有みならねは",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "恨みわひ涙に袖そ朽ぬへき我みひとつの憂になせとも",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "つらさをもたへて命のなからへは世にためしある恨とやせむ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "憂きを身の咎とはかりは知りなからつらさそ人に猶殘りける",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "とふ人は絕てあらしの音信て松にのみきく山かけの庵",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "たえてすむ友としきけは淋しさもうきになされぬ峯の松風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "馴なはと思ひしよりも淋しきはしのふみ山のまつの夕風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "としをへていく世の夢を殘しけん枕になるゝ峯の松かせ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "心をもすめとてしめし宿なれはさひしき松の風もいとはす",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "松風の吹ぬたえまも淋しさの猶かこたるゝ山かけのいほ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "たえすとふ松の嵐の音つれはなれてもさひしやまかけの庵",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "なれなはと何思ひけむ淋しさはおなしみ山の松の夕風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "さひしさをいかにしのへとまつ風のとひも忘ぬ軒はなるらん",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "山里のならひとおもふ淋しさもわけてしらるゝまつの夕風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "やま蔭の柴の庵はしはしにて軒はの松や千年をもへむ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "淋しさをうきになしても山さとに聞すてられぬ松のゆふ風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "ならひそとおもひなすにも山里の猶さひしきは松の夕かせ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "たゆむまはしはしまきるゝ淋しさもなを忘られぬ軒の松かせ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "庵はまた身をもかくさぬ山里に心こそすめ軒のまつ風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "いつとてもとふ人はなき山さとに心と誰をまつのゆふ風",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "なれなはとおもひし峯の松風になを淋しさをかこつ宿哉",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "さひしさはさらても同しやま里に松のあらしを何かこつらむ",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "たのますよみるもはなかき夢路より面影はかり通ふ昔は",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "ぬるかうちの夢には道もかひそなき現にかへる昔ならねば",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "今更にむかしを忍ふね覺哉なこりを夢のすゑにのこして",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "遠さかる昔を今と見る夢の覺るたゝちも現なるかは",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "はかなしやさむれはもとの古に又立かへるゆめのをも影",
   "kana": "",
   "speaker": "",
   "page": 356,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "をのつからみる俤もとまらぬは昔にかへる夢路也けり",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "なき人の面かけみせてぬるかうちの夢はむかしも隔さりけり",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "ゆめ路にもかよふたよりやなからまし現にしたふ昔ならすは",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "さめぬれは又今さらにしのふ哉夢を昔の佛にして",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "面影もありしはかりに見る程のゆめそ昔のかたみ也ける",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "みても猶はかなきものは思ひねの夢ちにかへる昔なりけり",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "夢のうちにかよふ計の佛は見るもはかなき昔なりけり",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "俤の人たのめなるむかし哉みてもとまらぬ夢にかよひて",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "いにしへをかへしてみつるうた〓ねの夢の名殘を又したふ哉",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "ありとても猶行すゑそたのまれぬ過にし方を夢と見るにも",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "いま更に覺ても落る淚かな昔にかよふゆめの名殘に",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "はかなしとおもひなからもたのむ哉昔は夢のほかに見えねは",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "面かけはさらても殘るいにしへを猶忍へとや夢にみゆらん",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "みしめ繩たのみをかくるかひあらは神の心もさそなひく覽",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "あめの下まもる誓ひも神風のおさまれる世の惠にそしる",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "天てらすみかけや更にうかふらむ心のみつのすむにまかせて",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "五十鈴川きよきなかれにすむ月の影にもふかき惠をそしる",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "ますかゝみいまも曇ぬ御かけこそ神代をうつすゝかた也けれ",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "跡たれて流たえせぬいすゝ川ふかき誓ひの程もかしこし",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "あま照すかみの惠は久かたの月日とゝもにつきしとそ思ふ",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "君か代を常盤にいのる榊葉に木綿四手なひくいせの神垣",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "ちかひをは神もへたてしみつ垣の內外にかはる宮ゐ也とも",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "岩戶明しよもの神わさなかりせは光あまねく世を照さめや",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "うこきなき下津岩根の宮柱いくたひ同し跡にたつらん",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "つかへても神の惠はしらゆふのかけて心にたのむ計そ",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "神代よりめくみはしけき芦原の國のさかへは今もかしこし",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "いすゝ川かみ代久しくすみそめてなかれの末そ限しられぬ",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "まことある人をや神も守らむめくみは同しちかひ成とも",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "內外とて分へき神の誓ひかはおなしめくみにてらす月日を",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "やはらけて光を塵にましへしや世を照すへき始也けり",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "みつかきのそともの宮ゐふりぬれと神の惠そ猶あらたなる",
   "kana": "",
   "speaker": "",
   "page": 357,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
